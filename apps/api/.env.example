# ─────────────────────────────────────────────────────────────
#  Sagarnu API — משתני סביבה
#  מקומית: העתיקו לקובץ apps/api/.env
#  ב-Railway: מוסיפים כל משתנה ב-Service → Variables
# ─────────────────────────────────────────────────────────────

# ===== חובה =====

# מחרוזת סודית אקראית (32+ תווים). ליצירה הריצו:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# חשוב: מחרוזת אחרת לפרודקשן, ולא משנים אותה אחר כך (זה מנתק את כל המשתמשים).
BETTER_AUTH_SECRET=

# הכתובת של אתר ה-web. מקומית localhost; ב-Railway: הכתובת של Vercel, למשל https://sagarnu.vercel.app
WEB_ORIGIN=http://localhost:3000

# מסד הנתונים.
# מקומית: pglite:local  ← Postgres מובנה, בלי שום התקנה. הנתונים נשמרים ב-%LOCALAPPDATA%\sagarnu
#   (מחוץ לפרויקט בכוונה: OneDrive/Dropbox משבשים את קבצי המסד אם הוא בתוך תיקייה מסונכרנת)
# ב-Railway: ${{Postgres.DATABASE_URL}}  (בדיוק ככה, Railway ממלא את הערך לבד)
DATABASE_URL=pglite:local

# מקומית: development (לוגים קריאים). ב-Railway לא מגדירים בכלל.
NODE_ENV=development

# ===== אופציונלי: התחברות עם Google =====
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI:  <WEB_ORIGIN>/v1/auth/callback/google
# אחרי שממלאים, צריך גם NEXT_PUBLIC_GOOGLE_ENABLED=true ב-web.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== אופציונלי: שליחת מיילים (Resend) =====
# בלי מפתח, המיילים (אימות, איפוס סיסמה) מודפסים ללוג של ה-API במקום להישלח.
# עם מפתח, אימות מייל הופך לחובה לפני יצירת אירוע (אפשר לשנות ב-REQUIRE_EMAIL_VERIFICATION).
RESEND_API_KEY=
# חייב להיות מדומיין שאומת ב-Resend. לבדיקות בלבד אפשר: Sagarnu <onboarding@resend.dev>
EMAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=

# ===== מתקדם =====
# מריץ migrations וזריעת קטגוריות בכל עלייה (ברירת מחדל: true)
MIGRATE_ON_START=true
LOG_LEVEL=info
# Railway מגדיר PORT לבד. מקומית ברירת המחדל 8080.
# PORT=8080

# ===== שלבים הבאים (עוד לא בשימוש בקוד) =====
# שלב 2 – ניתוח חוזים:  GROQ_API_KEY=
# שלב 2 – אחסון קבצים:  R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_BUCKET=
# שלב 3 – וואטסאפ:      WHATSAPP_PHONE_NUMBER_ID= WHATSAPP_ACCESS_TOKEN= WHATSAPP_APP_SECRET= WHATSAPP_VERIFY_TOKEN=
