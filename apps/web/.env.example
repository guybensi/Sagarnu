# ─────────────────────────────────────────────────────────────
#  Sagarnu Web — משתני סביבה
#  מקומית: העתיקו לקובץ apps/web/.env.local (אופציונלי, יש ברירות מחדל)
#  ב-Vercel: Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# לאן להעביר את בקשות /v1/* (ה-API).
# מקומית: http://localhost:8080
# ב-Vercel: הכתובת הציבורית של ה-API ב-Railway, למשל https://sagarnu-api-production.up.railway.app
# (בלי / בסוף. אחרי שינוי צריך Redeploy, כי הערך נקבע בזמן ה-build.)
API_URL=http://localhost:8080

# מציג את כפתור "המשך עם Google" (רק אחרי שהגדרתם GOOGLE_CLIENT_ID/SECRET ב-API)
NEXT_PUBLIC_GOOGLE_ENABLED=false
# true אחרי Publish של אפליקציית Google (Google Auth Platform → Audience). עד אז הכפתור מוצג כ"בקרוב".
NEXT_PUBLIC_GOOGLE_PUBLIC=false
